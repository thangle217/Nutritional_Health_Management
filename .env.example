# Sao chép file này thành .env (KHÔNG commit .env lên Git)
APP_ENV=local
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL 17 (chỉnh sửa DATABASE_PASSWORD theo mật khẩu bạn đặt khi cài PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/nhom12_dev?currentSchema=nutrition
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me

# JWT (dùng chuỗi bí mật >= 32 ký tự cho môi trường local/dev; tạo khóa mới khi triển khai)
JWT_ACCESS_SECRET=dev-only-change-this-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=dev-only-change-this-refresh-secret-key-min-32-chars

# Frontend & CORS
APP_FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
FILE_STORAGE_PATH=./data/uploads
