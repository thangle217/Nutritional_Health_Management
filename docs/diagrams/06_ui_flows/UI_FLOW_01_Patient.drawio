        <mxCell id="n1" value="Gửi Nhật ký ngày tự đẩy thẻ sự kiện sang SCR-PAT-08 (Chat) &amp;amp; thông báo Bác sĩ.&lt;br&gt;Hết hạn sửa 48h -&amp;gt; nút Gửi yêu cầu hiệu chỉnh (SCR-PAT-03B)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
