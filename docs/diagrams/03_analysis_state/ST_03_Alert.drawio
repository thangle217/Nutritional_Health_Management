        </mxCell>
        <mxCell id="n_st03" value="D05 &amp;amp; BR-05: YELLOW (lệch &amp;gt;15% Calo) và RED (vượt ngưỡng BP/Glucose) là mức độ, không phải trạng thái. Đọc thông báo và tiếp nhận cảnh báo là hai thao tác riêng.&lt;br&gt;SLA cảnh báo đỏ tính từ lúc phát sinh: quá 60 phút chưa tiếp nhận -&amp;gt; làm nổi bật; quá 2 giờ chưa giải quyết -&amp;gt; Trưởng khoa điều phối." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="1095" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="phát hiện vi phạm&lt;br&gt;[chưa có khóa trùng]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=9.5;fontColor=#111827;labelBackgroundColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;endArrow=open;endFill=0;endSize=9;startArrow=none;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="init" target="s_open">
