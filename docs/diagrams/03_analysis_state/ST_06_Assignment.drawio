          <mxGeometry x="6" y="6" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="n_st06" value="BR-01 &amp;amp; BR-06: Tối đa 30 ca TRACKING mỗi bác sĩ; kiểm tải trong giao dịch. PAUSED và AUTO_SUSPENDED giữ phân công, không chiếm tải.&lt;br&gt;AUTO_SUSPENDED áp dụng trên phân công sau ngày thứ 6 không tương tác chủ động (không khóa tài khoản). Điều chuyển đóng phân công cũ -&amp;gt; ENDED, tạo ca mới." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="35" y="550" width="1020" height="46" as="geometry"/>
        </mxCell>
